# Agentic Dev Flow — environment
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit it.
#
# Two audiences read these values:
#   - GitLab CI, where they are set as project CI/CD variables (Settings -> CI/CD ->
#     Variables). Mask ANTHROPIC_API_KEY and GITLAB_API_TOKEN there, and do not mark them
#     protected unless every branch that must run the review is protected too.
#   - your shell, when you run /opsx:review or .claude/scripts/mr.mjs locally.
#
# Note for the CI job specifically: infra/claude/review.sh deletes the local env file and
# the SSH key as its first act, before it builds the review payload, so that neither can
# be swept into the diff it sends to the API. Inside that job the values must therefore
# come from CI variables, not from a file on disk.


# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Anthropic API key used by infra/claude/review.sh to run the review.
ANTHROPIC_API_KEY=

# GitLab personal or project access token, `api` scope: the review reads the merge
# request diff and posts its verdict back as a note.
GITLAB_API_TOKEN=

# The forge host, without scheme or trailing slash - e.g. gitlab.com.
# Inside GitLab CI this may stay empty: CI_SERVER_HOST is predefined and used as the
# fallback. Outside CI it is required - review.sh exits 2 with a named error when neither
# is set, and mr.mjs prints <your-gitlab-host> in its glab auth hint.
GITLAB_HOST=

# The CI gate stays off unless this is exactly the string "true". Any other value, or
# unset, and the ai_claude_inspect job never runs. Deliberate opt-in: adopting the flow
# does not start spending API budget until someone turns it on.
AI_CLAUDE_INSPECT_ENABLED=false


# ---------------------------------------------------------------------------
# Optional - review.sh has a working default for every one of these
# ---------------------------------------------------------------------------

# Model used for the review. Defaults to claude-opus-5 - the expensive tier: $5 per
# million input tokens and $25 per million output. The report prints its own token counts
# and computed cost, so real spend is visible per merge request.
# Changing this needs a matching entry in review.sh's price table, or the reported cost
# will describe a different model. Unknown models report 0 and log a warning.
# Current model ids: https://platform.claude.com/docs/en/about-claude/models/overview
# CLAUDE_MODEL=claude-opus-5

# Ceiling for the review response. On a thinking model this caps thinking AND response
# text together, so a tight budget truncates the report - which fails review.sh's own
# structural check and reddens the pipeline for a non-code reason. Default 32000.
# CLAUDE_MAX_TOKENS=32000

# adaptive (default) or disabled.
# Keep adaptive. With thinking off, this model can leak literal <thinking> tags into the
# visible answer - here that means into claude-review.md, the artifact reviewers read.
# It is also rejected above 'high' effort: disabled + xhigh/max is a 400, which review.sh
# catches up front and exits 2 rather than letting it surface as an opaque API failure.
# CLAUDE_THINKING=adaptive

# low | medium (default) | high | xhigh | max.
# The real cost and latency lever - reach for this before switching models or disabling
# thinking. low and medium are strong on this model and the review stays accurate.
# CLAUDE_EFFORT=medium

# Per-million-token list rates, used only for the cost line in the report. The API does
# not report prices, so these come from a table in review.sh keyed on CLAUDE_MODEL.
# Override any of them to correct a stale rate without editing the script. Cache rates
# default to 1.25x (write) and 0.1x (read) of the input rate.
# CLAUDE_PRICE_INPUT=
# CLAUDE_PRICE_OUTPUT=
# CLAUDE_PRICE_CACHE_WRITE=
# CLAUDE_PRICE_CACHE_READ=


# ---------------------------------------------------------------------------
# Set by GitLab CI - do not put these here
# ---------------------------------------------------------------------------
#
# The pipeline provides these and review.sh reads them directly. Setting them by hand
# would only mask a misconfigured job:
#
#   CI_SERVER_HOST                        fallback for GITLAB_HOST
#   CI_PROJECT_ID                         which project's API to call
#   CI_MERGE_REQUEST_IID                  which merge request to review
#   CI_MERGE_REQUEST_ID                   used by the draft-quiet pipeline rules
#   CI_MERGE_REQUEST_TITLE                how the gate detects Draft:/WIP:/[skip-ci]
#   CI_MERGE_REQUEST_TARGET_BRANCH_NAME   the gate only runs against the integration branch
#   GITLAB_USER_LOGIN                     recorded as the actor in the posted verdict
