# Template for the env file adf-jira reads. Copy it into the host project, then fill it in:
#
#     cp <adf-jira plugin dir>/env.example .claude/.env
#
# The registry config's `envFile` names another path when the host wants one. The file holds a
# secret and personal logins: it is never committed. Verify with:
#
#     git check-ignore -v .claude/.env
#
# The agent never reads this file. The plugin's scripts load it inside their own process, and
# their diagnostics report a variable's name, the layer it came from and its length, never its
# value.
#
# Resolution order, first non-empty value wins:
#   1. the process environment
#   2. the project's env file (.claude/.env, or the config's envFile)
#   3. ~/.claude/.env
#
# The Jira URL and the project allowlist belong in the registry config of adf-jira (baseUrl,
# allowlist), which is committed. JIRA_URL and JIRA_ALLOWED_PROJECTS below are used only when
# the config does not set them.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Personal Access Token. Create it in Jira: avatar -> Profile -> Personal Access Tokens ->
# Create token. Give it a finite expiry. Jira Server and Data Center 8.14 and later support it.
JIRA_PAT=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Used only when the registry config sets no baseUrl, for example https://jira.example.com
JIRA_URL=

# Used only when the registry config sets no allowlist. A comma-separated list of project keys.
# A plan touching any issue outside it is refused whole. Never leave the allowlist empty: the
# scripts refuse to run unscoped.
JIRA_ALLOWED_PROJECTS=

# The project a command uses when it names none.
JIRA_DEFAULT_PROJECT=

# Your Jira login: the assignee when an issue is started, and the reporter and assignee of the
# issues the skills create. Empty: the account the token belongs to.
JIRA_ASSIGNEE=

# Your git author name, for a worklog practice that selects commits.
JIRA_GIT_AUTHOR=

# The login of the project manager who receives issues on a bulk close (<JIRA_PM> in a plan).
JIRA_PM=

# The login of the tester who receives issues at the hand-off (<JIRA_QA> in a plan).
JIRA_QA=
