{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adf/retro.schema.json",
  "title": "ADF retrospective reply",
  "description": "The retrospective agent's reply: findings about how the flow worked, a decision on every item waiting for data, one removal candidate and the improvements. It carries no number: every figure is a key of the input's `values`, and the script inserts the values. lib/retro.mjs check adds the rules a schema cannot state: every key exists, every waiting item is answered once, the removal candidate is computed or listed or `none`, a finding's plugin is enabled or installed, nothingFound agrees with the findings, the ids are unique and the changes are the window's.",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "nothingFound", "findings", "decisions", "removalCandidate", "improvements"],
  "properties": {
    "role": { "const": "retro" },
    "nothingFound": { "type": "boolean" },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "removalCandidate": { "$ref": "#/$defs/candidate" },
    "improvements": { "type": "array", "items": { "$ref": "#/$defs/improvement" } }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "key": { "type": "string", "minLength": 1 },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "class", "changes", "evidence", "cost", "caughtWhere", "plugin", "body"],
      "properties": {
        "id": { "type": "string", "pattern": "^R[1-9]\\d*$" },
        "title": { "$ref": "#/$defs/text" },
        "class": { "enum": ["late-caught", "re-derivation", "premature-done", "other"] },
        "changes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/key" } },
        "cost": { "type": ["string", "null"], "minLength": 1 },
        "caughtWhere": { "$ref": "#/$defs/text" },
        "plugin": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "body": { "$ref": "#/$defs/text" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "decision", "basis", "reason"],
      "properties": {
        "item": { "$ref": "#/$defs/text" },
        "decision": { "enum": ["keep", "remove", "wait"] },
        "basis": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/key" } },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reason", "basis"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" },
        "basis": { "type": "array", "items": { "$ref": "#/$defs/key" } }
      }
    },
    "improvement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["what", "file", "expectedEffect", "saving"],
      "properties": {
        "what": { "$ref": "#/$defs/text" },
        "file": { "$ref": "#/$defs/text" },
        "expectedEffect": { "$ref": "#/$defs/text" },
        "saving": { "$ref": "#/$defs/key" }
      }
    }
  }
}
