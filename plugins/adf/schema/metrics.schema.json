    },
    {
      "if": { "required": ["isolation"], "properties": { "isolation": { "type": ["object", "array"] } } },
      "then": {
        "properties": {
          "sources": { "properties": { "coverage": { "properties": { "isolation": { "const": "record" } } } } }
