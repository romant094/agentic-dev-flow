    },
    {
      "if": { "required": ["maintainability"], "properties": { "maintainability": { "type": "null" } } },
      "then": {
        "properties": {
          "sources": { "properties": { "coverage": { "properties": { "maintainability": { "type": "object" } } } } }
        }
      }
    },
    {
      "if": {
        "required": ["maintainability"],
        "properties": { "maintainability": { "type": ["object", "array"] } }
      },
      "then": {
        "properties": {
          "sources": { "properties": { "coverage": { "properties": { "maintainability": { "const": "record" } } } } }
        }
      }
    }
  ],
  "$defs": {
    "time": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "count": { "type": "integer", "minimum": 0 },
    "coverage": {
      "type": ["string", "object"],
      "allOf": [
        { "if": { "type": "string" }, "then": { "const": "record" } },
        {
          "if": { "type": "object" },
          "then": {
            "additionalProperties": false,
            "required": ["none"],
            "properties": { "none": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "bucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "thinking", "cacheRead", "cacheWrite5m", "cacheWrite1h", "turns", "placeholderTurns"],
      "properties": {
        "input": { "$ref": "#/$defs/count" },
        "output": { "$ref": "#/$defs/count" },
        "thinking": { "$ref": "#/$defs/count" },
        "cacheRead": { "$ref": "#/$defs/count" },
        "cacheWrite5m": { "$ref": "#/$defs/count" },
        "cacheWrite1h": { "$ref": "#/$defs/count" },
        "turns": { "$ref": "#/$defs/count" },
        "placeholderTurns": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dispatches", "findings", "native", "mapped"],
      "properties": {
        "dispatches": { "$ref": "#/$defs/count" },
        "findings": { "$ref": "#/$defs/count" },
        "native": { "type": ["object", "null"] },
        "mapped": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["CRITICAL", "HIGH", "MEDIUM", "LOW"],
          "properties": {
            "CRITICAL": { "$ref": "#/$defs/count" },
            "HIGH": { "$ref": "#/$defs/count" },
            "MEDIUM": { "$ref": "#/$defs/count" },
            "LOW": { "$ref": "#/$defs/count" }
          }
        },
        "uncounted": { "$ref": "#/$defs/count" }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "agentId", "parentAgentId", "name", "role", "task", "group", "round", "exact", "actor", "agentType", "level", "missing", "reason", "model", "effort", "phase", "turns", "tokens", "startedAt", "endedAt", "coldResumes", "activeMinutes"],
      "properties": {
        "sessionId": { "type": "string" },
        "agentId": { "type": "string" },
        "parentAgentId": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"] },
        "task": { "type": ["integer", "null"] },
        "group": { "type": ["string", "null"] },
        "round": { "type": ["integer", "null"] },
        "exact": { "type": "boolean" },
        "actor": { "enum": ["controller", "worker"] },
        "agentType": { "type": ["string", "null"] },
        "level": { "type": ["string", "null"] },
        "missing": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "effort": { "type": ["string", "null"] },
        "phase": { "type": ["string", "null"] },
        "turns": { "type": ["integer", "null"], "minimum": 0 },
        "tokens": {
          "type": ["object", "null"],
          "allOf": [{ "if": { "type": "object" }, "then": { "$ref": "#/$defs/bucket" } }]
        },
        "startedAt": { "type": ["string", "null"] },
        "endedAt": { "type": ["string", "null"] },
        "coldResumes": { "type": ["integer", "null"], "minimum": 0 },
        "activeMinutes": { "type": ["number", "null"] }
      }
    }
  }
}
