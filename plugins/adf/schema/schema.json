{
  "name": "adf",
  "version": 1,
  "description": "Spec-driven change workflow on Superpowers skills: brainstorm, proposal, specs, tasks, plan, verify, review. design is optional: produced from brainstorm, required by nothing.",
  "artifacts": [
    {
      "id": "brainstorm",
      "generates": "brainstorm.md",
      "description": "Collaborative design exploration using Superpowers brainstorming",
      "template": "brainstorm.md",
      "instruction": "brainstorm.md",
      "requires": []
    },
    {
      "id": "proposal",
      "generates": "proposal.md",
      "description": "Initial proposal document outlining the change",
      "template": "proposal.md",
      "instruction": "proposal.md",
      "requires": ["brainstorm"]
    },
    {
      "id": "design",
      "generates": "design.md",
      "description": "Technical design document with implementation details",
      "template": "design.md",
      "instruction": "design.md",
      "requires": ["brainstorm"]
    },
    {
      "id": "specs",
      "generates": "specs/**/*.md",
      "description": "Detailed specifications for the change",
      "template": "spec.md",
      "instruction": "specs.md",
      "gates": ["specs-validate", "specs-capabilities", "specs-against-main", "specs-base"],
      "requires": ["proposal"]
    },
    {
      "id": "tasks",
      "generates": "tasks.md",
      "description": "Implementation checklist with trackable tasks",
      "template": "tasks.md",
      "instruction": "tasks.md",
      "gates": ["tasks-lint"],
      "requires": ["specs"]
    },
    {
      "id": "plan",
      "generates": "plan.md",
      "description": "Step-by-step execution plan from Superpowers writing-plans",
      "template": "plan.md",
      "instruction": "plan.md",
      "guides": ["planning.md"],
      "gates": ["plan-symbols", "plan-lint"],
      "requires": ["tasks"]
    },
    {
      "id": "verify",
      "generates": "verify.md",
      "description": "Verification report: was the change actually built",
      "template": "verify.md",
      "instruction": "verify.md",
      "guides": ["planning.md"],
      "requires": ["plan"]
    },
    {
      "id": "review",
      "generates": "review.md",
      "description": "Code review record and the disposition of every finding",
      "template": "review.md",
      "instruction": "review.md",
      "requires": ["verify"]
    }
  ],
  "blocks": {
    "propose": "propose.md",
    "resolve": "resolve.md",
    "archive": "archive.md"
  },
  "apply": {
    "requires": ["plan"],
    "tracks": "tasks.md",
    "instruction": "apply.md",
    "guides": ["planning.md"]
  }
}
