{
  "description": "Stops npm install, ci, add, update and uninstall in a linked git worktree",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\""
          }
        ]
      }
    ]
  }
}
